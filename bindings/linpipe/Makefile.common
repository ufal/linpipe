CPP_STANDARD = c++20
LINPIPE_SRC = ../../src
include ../../src/Makefile.builtem
include ../../src/Makefile.include

SWIG_FLAGS+=-O -c++ -outcurrentdir
BINDING_C_FLAGS:=$(filter-out $(default_warnings) $(treat_warnings_as_errors),$(C_FLAGS))
BINDING_LINPIPE_OBJECTS=$(addprefix ../../src/,$(call dynobj,$(LINPIPE_OBJECTS)))

.PHONY: binding_linpipe_o
$(BINDING_LINPIPE_OBJECTS): binding_linpipe_o
binding_linpipe_o:
	@$(MAKE) -C ../../src $(call dynobj,$(LINPIPE_OBJECTS))

.DEFAULT_GOAL :=
